# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 로그인할 수 있는 두 이메일, 쉼표로 구분
ALLOWED_EMAILS=a@gmail.com,b@gmail.com

# Supabase 명령어 도구용 (내 컴퓨터에서만. Vercel에는 넣지 않는다)
# supabase.com → 오른쪽 위 계정 → Account preferences → Access Tokens
SUPABASE_ACCESS_TOKEN=
# 프로젝트 만들 때 정한 DB 비밀번호
SUPABASE_DB_PASSWORD=

# 휴대폰 알림(웹 푸시, F-57). 키 만들기: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 공개키는 공개돼도 되는 값(서버가 설정 화면에 넘겨줌), 비밀키는 서버 전용. Vercel에도 같은 이름으로 등록한다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 알림을 보내는 쪽 연락처 (운영 주소 또는 mailto:)
VAPID_SUBJECT=

# Supabase 7일 정지 막기: Vercel Cron이 하루 한 번 /api/keep-alive를 부를 때 보내는 비밀값.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (Vercel에만 등록하면 된다)
CRON_SECRET=
